---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Estimate reading time from body
const words = post.body.trim().split(/\s+/).length;
const readTime = Math.max(1, Math.ceil(words / 200));

const formattedDate = new Date(post.data.publishDate).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article class="group flex flex-col bg-white dark:bg-[#121212] border border-neutral-200 dark:border-neutral-800 rounded-xl overflow-hidden hover:border-[#FF4400] dark:hover:border-[#FF5500] transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
  <!-- Cover Image -->
  {post.data.coverImage && (
    <a href={`${baseUrl}/blog/${post.slug}`} class="block aspect-[16/10] overflow-hidden bg-neutral-100 dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800">
      <img 
        src={post.data.coverImage} 
        alt={post.data.title}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </a>
  )}

  <div class="flex-1 p-6 flex flex-col justify-between">
    <div>
      <!-- Meta: Category, Date, Read Time -->
      <div class="flex items-center gap-2.5 text-xs text-neutral-500 dark:text-neutral-400 mb-3 font-mono">
        <span class="inline-block px-2 py-0.5 rounded font-semibold tracking-wider uppercase text-[10px] bg-neutral-100 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-700">
          {post.data.category}
        </span>
        <span>&bull;</span>
        <time datetime={post.data.publishDate.toISOString()}>{formattedDate}</time>
        <span>&bull;</span>
        <span>{readTime} min read</span>
      </div>

      <!-- Title -->
      <h3 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 group-hover:text-[#FF4400] dark:group-hover:text-[#FF5500] transition-colors leading-snug mb-2.5">
        <a href={`${baseUrl}/blog/${post.slug}`}>
          {post.data.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3 leading-relaxed mb-4">
        {post.data.description}
      </p>
    </div>

    <!-- Tags & Arrow -->
    <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-between">
      <div class="flex flex-wrap gap-1.5">
        {post.data.tags.slice(0, 2).map((tag) => (
          <span class="text-[11px] font-mono text-neutral-500 dark:text-neutral-400">
            #{tag}
          </span>
        ))}
      </div>
      <span class="text-neutral-400 group-hover:text-[#FF4400] dark:group-hover:text-[#FF5500] transition-transform group-hover:translate-x-1 text-sm font-semibold">
        &rarr;
      </span>
    </div>
  </div>
</article>
