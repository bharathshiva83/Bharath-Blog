---
import Layout from '../layouts/Layout.astro';
import { projects, personalInfo } from '../data/profile';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`Projects — ${personalInfo.name}`}>
  <div class="space-y-8">
    <div class="space-y-2 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Projects
      </h1>
      <p class="text-xs font-mono text-neutral-500">
        AI systems, computer vision models, and edge-inference applications.
      </p>
    </div>

    <div class="space-y-4">
      {projects.map((proj) => (
        <div class="p-5 rounded-lg border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30 space-y-3">
          <div class="flex items-start justify-between gap-2">
            <h2 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
              {proj.title}
            </h2>
            <div class="flex items-center gap-3 text-xs font-mono text-neutral-400">
              {proj.github && (
                <a href={proj.github} target="_blank" rel="noopener noreferrer" class="hover:underline">Code &nearr;</a>
              )}
              {proj.demo && (
                <a href={proj.demo} target="_blank" rel="noopener noreferrer" class="hover:underline">Live &nearr;</a>
              )}
            </div>
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {proj.description}
          </p>
          <div class="flex flex-wrap gap-1.5 pt-1">
            {proj.tags.map(t => (
              <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                {t}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="pt-6 border-t border-neutral-200 dark:border-neutral-800 text-xs font-mono">
      <a href={`${baseUrl}/`} class="text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors">
        &larr; Back to home
      </a>
    </div>
  </div>
</Layout>
