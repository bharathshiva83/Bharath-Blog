---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('blog');
const categories = Array.from(new Set(allPosts.map(p => p.data.category)));

const postsByCategory = categories.map(cat => ({
  category: cat,
  posts: allPosts
    .filter(p => p.data.category === cat)
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
}));

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Categories — Bharath Shiva Editorial Blog">
  <div class="max-w-6xl mx-auto py-6">
    <!-- Header -->
    <header class="pb-10 border-b border-neutral-200 dark:border-neutral-800 mb-12">
      <span class="text-xs font-mono uppercase tracking-wider text-[#FF4400] font-semibold mb-3 block">
        Index & Taxonomy
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 mb-4">
        All Categories
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 font-light">
        Explore articles organized by topic and domain expertise.
      </p>

      <!-- Category Quick Jumper -->
      <div class="flex items-center gap-3 mt-8 flex-wrap">
        {categories.map(cat => (
          <a 
            href={`#${cat.toLowerCase()}`}
            class="px-4 py-1.5 rounded-full text-xs font-mono uppercase tracking-wider bg-white dark:bg-[#121212] border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:border-[#FF4400] transition-colors"
          >
            {cat} ({allPosts.filter(p => p.data.category === cat).length})
          </a>
        ))}
      </div>
    </header>

    <!-- Category Sections -->
    <div class="space-y-16">
      {postsByCategory.map(({ category, posts }) => (
        <section id={category.toLowerCase()} class="pt-6">
          <div class="flex items-center gap-3 mb-8 pb-3 border-b border-neutral-200 dark:border-neutral-800">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FF4400]"></span>
            <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
              {category}
            </h2>
            <span class="text-xs font-mono text-neutral-400">
              ({posts.length} {posts.length === 1 ? 'article' : 'articles'})
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {posts.map(post => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Layout>
